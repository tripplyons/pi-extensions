#!/usr/bin/env bash
# A stand-in for `pi --mode rpc` used by pi-desk's tests and for trying the
# app without model calls. Each prompt compacts, continues, and asks one
# ask_user question. The answer writes answer.txt and finishes with a summary.
set -u
# A separate print request writes the final commit message, not task files.
if [[ " ${*} " == *" --print "* ]]; then
  input=$(cat)
  for flag in --no-session --no-tools --no-mcp --no-context-files; do
    [[ " ${*} " == *" ${flag} "* ]] || exit 2
  done
  [[ "$input" == *'Task summary:'* && "$input" == *'Final diff'* ]] || exit 2
  printf 'Write the selected greeting to answer.txt\n\nUse the user\x27s selected greeting in the generated file.\n'
  exit 0
fi
provider=fake
model=reasoning
effort=medium
while (( $# )); do
  case "$1" in
    --provider) provider=$2; shift ;;
    --model) model=$2; shift ;;
    --thinking) effort=$2; shift ;;
  esac
  shift
done
# FAKE_PI_SCOPE mimics Pi's enabledModels: a space-separated model cycle
# drawn from a catalog that also includes an unscoped "other" model.
scope=${FAKE_PI_SCOPE:-}
catalog='{"provider":"fake","id":"reasoning"},{"provider":"fake","id":"plain"}'
[[ -z "$scope" ]] || catalog+=',{"provider":"fake","id":"other"}'
[[ "$model" == plain || "$model" == reasoning ]] || model=reasoning
[[ "$provider" == fake ]] || provider=fake
[[ "$model" != plain ]] || effort=off
field() {
  local value=${line#*\"$1\":\"}
  printf '%s' "${value%%\"*}"
}
session_file="$PWD/.fake-pi-session.jsonl"
session_name=""
streaming=false
while IFS= read -r line; do
  request_id=$(field id)
  case "$line" in
    *'"type":"get_available_models"'*)
      printf '{"id":"%s","type":"response","command":"get_available_models","success":true,"data":{"models":[%s]}}\n' "$request_id" "$catalog"
      ;;
    *'"type":"cycle_model"'*)
      read -r -a cycle <<< "${scope:-reasoning plain}"
      if (( ${#cycle[@]} <= 1 )); then
        printf '{"id":"%s","type":"response","command":"cycle_model","success":true,"data":null}\n' "$request_id"
      else
        next=${cycle[1]}
        for i in "${!cycle[@]}"; do
          [[ "${cycle[$i]}" != "$model" ]] || next=${cycle[$(( (i + 1) % ${#cycle[@]} ))]}
        done
        model=$next
        scoped=false
        [[ -z "$scope" ]] || scoped=true
        printf '{"id":"%s","type":"response","command":"cycle_model","success":true,"data":{"model":{"provider":"fake","id":"%s"},"thinkingLevel":"%s","isScoped":%s}}\n' "$request_id" "$model" "$effort" "$scoped"
      fi
      ;;
    *'"type":"get_available_thinking_levels"'*)
      levels='["off","minimal","low","medium","high","xhigh","max"]'
      [[ "$model" != plain ]] || levels='["off"]'
      printf '{"id":"%s","type":"response","command":"get_available_thinking_levels","success":true,"data":{"levels":%s}}\n' "$request_id" "$levels"
      ;;
    *'"type":"set_model"'*)
      selected=$(field modelId)
      if [[ "$selected" == plain || "$selected" == reasoning ]]; then
        model=$selected
        [[ "$model" != plain ]] || effort=off
        printf '{"id":"%s","type":"response","command":"set_model","success":true,"data":{"provider":"fake","id":"%s"}}\n' "$request_id" "$model"
      else
        printf '{"id":"%s","type":"response","command":"set_model","success":false,"error":"Model unavailable"}\n' "$request_id"
      fi
      ;;
    *'"type":"set_thinking_level"'*)
      effort=$(field level)
      [[ "$model" != plain ]] || effort=off
      printf '{"id":"%s","type":"response","command":"set_thinking_level","success":true}\n' "$request_id"
      ;;
    *'"type":"get_state"'*)
      printf '{"id":"%s","type":"response","command":"get_state","success":true,"data":{"sessionFile":"%s","sessionId":"fake","sessionName":"%s","isStreaming":%s,"isCompacting":false,"pendingMessageCount":0,"model":{"provider":"%s","id":"%s"},"thinkingLevel":"%s"}}\n' "$request_id" "$session_file" "$session_name" "$streaming" "$provider" "$model" "$effort"
      ;;
    *'"type":"get_messages"'*)
      printf '{"id":"messages","type":"response","command":"get_messages","success":true,"data":{"messages":[{"role":"user","content":"earlier prompt"}]}}\n'
      ;;
    *'"type":"prompt"'*)
      printf '{"type":"response","command":"prompt","success":true,"data":{"disposition":"started"}}\n'
      streaming=true
      printf '{"type":"agent_start"}\n'
      printf '{"type":"agent_settled","aborted":true}\n'
      printf '{"type":"compaction_start","reason":"manual"}\n'
      printf '{"type":"compaction_end","reason":"manual","aborted":false,"willRetry":false,"result":{}}\n'
      printf '{"type":"agent_start"}\n'
      printf '{"type":"message_start","message":{"role":"user","content":"prompt"}}\n'
      printf '{"type":"message_start","message":{"role":"assistant","content":[]}}\n'
      printf '{"type":"message_update","usage":{},"assistantMessageEvent":{"type":"text_delta","contentIndex":0,"delta":"I need a decision."}}\n'
      printf '{"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"I need a decision."}],"stopReason":"toolUse"}}\n'
      printf '{"type":"tool_execution_start","toolCallId":"ask1","toolName":"ask_user","args":{"question":"Which greeting should the file use?","choices":["Hello","Hi"],"recommended":2}}\n'
      printf '{"type":"extension_ui_request","id":"q1","method":"select","title":"Which greeting should the file use?","options":["Hello","Hi","Other (type an answer)"]}\n'
      ;;
    *'"type":"extension_ui_response"'*'"value":"Other (type an answer)"'*|*'"value":"Other (type an answer)"'*'"type":"extension_ui_response"'*)
      printf '{"type":"extension_ui_request","id":"q2","method":"input","title":"Which greeting should the file use?"}\n'
      ;;
    *'"type":"extension_ui_response"'*)
      answer=$(printf '%s' "$line" | sed -E 's/.*"value":"([^"]*)".*/\1/')
      printf '%s\n' "$answer" > answer.txt
      printf '{"type":"tool_execution_end","toolCallId":"ask1","toolName":"ask_user","result":{"content":[{"type":"text","text":"%s"}]},"isError":false}\n' "$answer"
      printf '{"type":"tool_execution_start","toolCallId":"w1","toolName":"write","args":{"path":"answer.txt"}}\n'
      printf '{"type":"tool_execution_end","toolCallId":"w1","toolName":"write","result":{"content":[{"type":"text","text":"Wrote answer.txt"}]},"isError":false}\n'
      printf '{"type":"message_start","message":{"role":"assistant","content":[]}}\n'
      printf '{"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"Wrote the greeting.\\nDid: Wrote %s to answer.txt.\\nNeeds: Review and merge"}],"stopReason":"stop"}}\n' "$answer"
      printf '{"type":"agent_end","messages":[],"willRetry":false}\n'
      session_name="Write a greeting file"
      streaming=false
      printf '{"type":"agent_settled","aborted":false}\n'
      ;;
  esac
done
