#!/usr/bin/env -S uv run -s
# /// script
# requires-python = ">=3.12"
# dependencies = [
#   "beautifulsoup4>=4.13",
#   "camoufox[geoip]",
#   "ddgs>=9",
#   "html2text>=2025.4.15",
# ]
# ///

import argparse
import asyncio
import re
import sys
from typing import Any

from ddgs import DDGS


def search(args: argparse.Namespace) -> None:
    kwargs: dict[str, Any] = {"max_results": args.max_results, "backend": args.backend}
    if args.region:
        kwargs["region"] = args.region
    if args.timelimit:
        kwargs["timelimit"] = args.timelimit

    results = DDGS().text(args.query, **kwargs)
    print(f"Provider: ddgs\nQuery: {args.query}\n")
    print(format_search_results(args.query, results), end="")


def extract(args: argparse.Namespace) -> None:
    if args.provider == "ddgs":
        content = extract_with_ddgs(args.url)
        source = "ddgs"
    elif args.provider == "camoufox":
        content = asyncio.run(extract_with_camoufox(args.url, args.timeout))
        source = "camoufox"
    else:
        source, content = extract_auto(args.url, args.timeout)

    print(f"Provider: {source}\nURL: {args.url}\n")
    print(content.rstrip())


def extract_auto(url: str, timeout: float) -> tuple[str, str]:
    failures: list[str] = []
    try:
        return "ddgs", extract_with_ddgs(url)
    except Exception as exc:
        failures.append(f"DDGS: {exc}")
        print(f"DDGS extraction failed; falling back to Camoufox: {exc}", file=sys.stderr)

    try:
        return "camoufox", asyncio.run(extract_with_camoufox(url, timeout))
    except Exception as exc:
        failures.append(f"Camoufox: {exc}")

    raise RuntimeError("; ".join(failures))


def extract_with_ddgs(url: str) -> str:
    result = DDGS().extract(url, fmt="text_markdown")
    content = str(result.get("content", "")).strip()
    validate_extracted_content(content, "DDGS")
    return content


BLOCKED_PAGE_PHRASES = [
    "let's confirm you are human",
    "confirm you are human",
    "complete the security check",
    "before proceeding to your request",
    "you need to solve a puzzle",
    "temporary error. please try again.",
    "verify that you are not a bot",
    "are you a human",
    "captcha",
]


def validate_extracted_content(content: str, source: str) -> None:
    if not content:
        raise RuntimeError(f"{source} returned empty content")
    normalized = re.sub(r"\s+", " ", content).casefold()
    phrase = next((phrase for phrase in BLOCKED_PAGE_PHRASES if phrase in normalized), None)
    if phrase:
        raise RuntimeError(f"{source} returned a bot-check / captcha page matching phrase: {phrase!r}")


async def extract_with_camoufox(url: str, timeout: float) -> str:
    from camoufox.async_api import AsyncCamoufox

    timeout_ms = max(1000, int(timeout * 1000))
    async with AsyncCamoufox(headless=True) as browser:
        page = await browser.new_page()
        page.set_default_timeout(timeout_ms)
        page.set_default_navigation_timeout(timeout_ms)
        try:
            await page.goto(url, wait_until="load", timeout=timeout_ms)
        except Exception as exc:
            print(f"Camoufox load ended before full load state: {exc}", file=sys.stderr)
        html = await page.content()

    markdown = rendered_html_to_markdown(html).strip()
    validate_extracted_content(markdown, "Camoufox")
    return markdown


def rendered_html_to_markdown(html: str) -> str:
    import html2text

    converter = html2text.HTML2Text()
    converter.body_width = 0
    converter.ignore_links = False
    converter.ignore_images = False
    markdown = converter.handle(markdown_html(html))
    markdown = re.sub(r"\)(?=!\[)", ") ", markdown)
    markdown = re.sub(r"\s+([,.;:?])", r"\1", markdown)
    lines = [line.rstrip() for line in markdown.splitlines()]
    return "\n".join(lines).strip()


def markdown_html(html: str) -> str:
    from bs4 import BeautifulSoup, NavigableString, Tag

    soup = BeautifulSoup(html, "html.parser")
    for node in soup(["script", "style", "noscript"]):
        node.decompose()

    inline_tags = {"a", "button", "code", "em", "img", "label", "small", "span", "strong"}
    for node in list(soup.find_all(inline_tags)):
        if inline_needs_trailing_space(node, inline_tags):
            node.insert_after(NavigableString(" "))
    return str(soup)


def inline_needs_trailing_space(node: "Tag", inline_tags: set[str]) -> bool:
    from bs4 import NavigableString, Tag

    if not inline_text(node):
        return False

    sibling = node.next_sibling
    while sibling is not None:
        if isinstance(sibling, NavigableString):
            return bool(sibling) and not sibling[0].isspace()
        if isinstance(sibling, Tag):
            return sibling.name in inline_tags and bool(inline_text(sibling))
        sibling = sibling.next_sibling
    return False


def inline_text(node: "Tag") -> str:
    return node.get_text(strip=True) or str(node.get("alt") or node.get("title") or "").strip()


def format_search_results(query: str, results: list[dict[str, Any]]) -> str:
    lines = [f"# Search results: {query}", ""]
    for index, result in enumerate(results, 1):
        title = str(result.get("title") or "Untitled")
        url = str(result.get("href") or result.get("url") or "")
        body = str(result.get("body") or "").strip()
        if url:
            lines.append(f"{index}. [{title}]({url})")
        else:
            lines.append(f"{index}. {title}")
        if body:
            lines.append(f"   {body}")
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="web-search-and-extract",
        description="Search with DDGS and extract pages with selectable providers.",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    search_parser = subparsers.add_parser("search", help="Search the web with DDGS.")
    search_parser.add_argument("query")
    search_parser.add_argument("-m", "--max-results", type=int, default=5)
    search_parser.add_argument("-r", "--region")
    search_parser.add_argument("-t", "--timelimit", choices=["d", "w", "m", "y"])
    search_parser.add_argument("-b", "--backend", default="auto")
    search_parser.set_defaults(func=search)

    extract_parser = subparsers.add_parser("extract", help="Extract a URL to markdown.")
    extract_parser.add_argument("url")
    extract_parser.add_argument(
        "--provider",
        choices=["auto", "ddgs", "camoufox"],
        default="auto",
        help="Extraction provider. auto tries DDGS first, then Camoufox fallback.",
    )
    extract_parser.add_argument("--timeout", type=float, default=10.0)
    extract_parser.set_defaults(func=extract)

    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        args.func(args)
    except KeyboardInterrupt:
        return 130
    except Exception as exc:
        print(f"web-search-and-extract: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
