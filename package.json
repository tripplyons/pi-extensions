{
  "name": "@tripplyons/pi-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Pi extensions, bundled skills, and tests",
  "keywords": ["pi-package"],
  "scripts": {
    "test": "bash extensions/run-tests.sh"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-codex-conversion/index.ts",
      "./extensions/agent-swarm/index.ts",
      "./extensions/auto-rename/index.ts",
      "./extensions/autocomplete/index.ts",
      "./extensions/btw/index.ts",
      "./extensions/clean-footer/index.ts",
      "./extensions/fast/index.ts",
      "./extensions/hide-empty-editor/index.ts",
      "./extensions/message-window/index.ts",
      "./extensions/nvim-session-export/index.ts",
      "./extensions/stash/index.ts",
      "./extensions/subagent/index.ts",
      "./extensions/syntax-punctuation/index.ts",
      "./extensions/thinking-counter/index.ts",
      "./extensions/tripp-autoresearch/index.ts"
    ]
  },
  "dependencies": {
    "@howaboua/pi-codex-conversion": "3.0.30"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  }
